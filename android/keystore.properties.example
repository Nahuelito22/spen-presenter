# Copia este archivo como keystore.properties y completa los valores.
# keystore.properties y el .jks estan en .gitignore: NUNCA se suben al repo.
#
# Para generar el keystore (una sola vez, guardalo donde no se pierda:
# si lo perdes no podes volver a firmar actualizaciones de la misma app):
#
#   keytool -genkeypair -v -keystore spen-presenter.jks \
#     -alias spen-presenter -keyalg RSA -keysize 4096 -validity 10000

storeFile=spen-presenter.jks
storePassword=
keyAlias=spen-presenter
keyPassword=
